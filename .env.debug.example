# Secrets debug-only. Copier en .env.debug et lancer avec
# `docker compose --env-file .env.debug -f docker-compose.debug.yml ...`
# pour surcharger les valeurs par défaut.
TAROT_DEBUG_INTERNAL_TOKEN=debug-internal-token-0000000000000000
TAROT_DEBUG_SESSION_SECRET=debug-session-secret-0000000000000000
TAROT_DEBUG_USER_NAME=Debug User
GIT_COMMIT=unknown
