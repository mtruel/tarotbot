# Copier ce fichier en .env (hors Git) et renseigner le token Discord.
# Régénérer le token dans le portail Discord s'il a pu fuiter.
DISCORD_TOKEN=<TOKEN_DISCORD>

# Sauvegarde restic (dépôt local) + copie Google Drive (remote rclone « gdrive »).
# Le token s'obtient depuis un poste avec navigateur : `rclone authorize "drive"`.
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive
RCLONE_CONFIG_GDRIVE_ROOT_FOLDER_ID=<ID_DU_DOSSIER_DRIVE>
RCLONE_CONFIG_GDRIVE_TOKEN=<JSON_TOKEN_RCLONE>

# Sous-dossier Drive (optionnel, défaut : TarotBot).
# Dépôt restic Drive : rclone:gdrive:<BACKUP_DEST_PATH>/restic ; zip latest :
# <BACKUP_DEST_PATH>/tarotbot-latest.zip
# BACKUP_DEST_PATH=TarotBot

# Dépôt restic local (optionnel, défaut : /data/restic dans le conteneur).
# RESTIC_REPOSITORY=/data/restic

# Mot de passe du dépôt restic.
# OPTIONNEL : un mot de passe par défaut est défini dans
# tarot_commands/backup_lib.py (DEFAULT_PASSWORD). Décommenter pour en utiliser un autre.
# Pour le changer après coup : `restic key passwd` (dépôt local) et
# `restic -r rclone:gdrive:TarotBot/restic key passwd` (Drive).
# RESTIC_PASSWORD=<MOT_DE_PASSE_RESTIC>

# Politique de rétention des snapshots (optionnel), appliquée séparément au
# dépôt local et au dépôt Drive.
# Tous les snapshots sur BACKUP_KEEP_RECENT_DAYS jours, puis le plus récent de
# chaque semaine pendant BACKUP_KEEP_WEEKLY_DAYS, puis le plus récent de chaque
# mois civil (illimité) au-delà.
# BACKUP_KEEP_RECENT_DAYS=30
# BACKUP_KEEP_WEEKLY_DAYS=183

# Jour (0 = lundi … 6 = dimanche) du `prune` lourd sur Drive (optionnel).
# BACKUP_REMOTE_PRUNE_WEEKDAY=6
